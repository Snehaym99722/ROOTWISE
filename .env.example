# Copy to backend/.env. Never put provider keys in frontend files or commit secrets.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional production-style database. Leave blank to use backend/rootwise.db (SQLite demo fallback).
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional local authenticated QA approval. Generate a PBKDF2 hash with:
# cd backend && python -m app.create_password_hash
ROOTWISE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ROOTWISE_REVIEWERS_JSON=[]

# Optional OCR for scanned PDFs (install Tesseract OCR separately on Windows).
TESSERACT_CMD=
