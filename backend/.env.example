# Copy to backend/.env. Keep all provider and session secrets server-side.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set a PostgreSQL URL to use PostgreSQL; blank uses the local SQLite fallback.
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required for authenticated QA approval. Use at least 32 random characters.
ROOTWISE_SESSION_SECRET=
# Generate a PBKDF2 password hash with: python -m app.create_password_hash
ROOTWISE_REVIEWERS_JSON=[]

# Optional scanned PDF OCR. Install Tesseract OCR separately and set its exe path.
TESSERACT_CMD=
